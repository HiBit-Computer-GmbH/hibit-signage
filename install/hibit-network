#!/usr/bin/env python3
import sys
from pathlib import Path

candidates = [
    Path("/opt/hibit-signage/player"),
    Path(__file__).resolve().parents[1] / "player",
]
for path in candidates:
    if (path / "hibit_player" / "netcfg.py").exists():
        sys.path.insert(0, str(path))
        break
else:
    sys.stderr.write("HiBit Signage wurde nicht gefunden.\n")
    sys.exit(1)

from hibit_player.netcfg import main

main()
